{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 6
  },
  "configurePresets": [
    {
      "name": "manifest-check",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/manifest",
      "cacheVariables": {
        "NPP_LDAP_MANIFEST_ONLY": "ON"
      }
    },
    {
      "name": "win32",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32,version=10.0.26100.0",
      "toolset": "v143,version=14.44.35207",
      "binaryDir": "${sourceDir}/.build/win32",
      "cacheVariables": {
        "CMAKE_SYSTEM_VERSION": "10.0.26100.0"
      }
    },
    {
      "name": "x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64,version=10.0.26100.0",
      "toolset": "v143,version=14.44.35207",
      "binaryDir": "${sourceDir}/.build/x64",
      "cacheVariables": {
        "CMAKE_SYSTEM_VERSION": "10.0.26100.0"
      }
    },
    {
      "name": "arm64",
      "generator": "Visual Studio 17 2022",
      "architecture": "ARM64,version=10.0.26100.0",
      "toolset": "v143,version=14.44.35207",
      "binaryDir": "${sourceDir}/.build/arm64",
      "cacheVariables": {
        "CMAKE_SYSTEM_VERSION": "10.0.26100.0"
      }
    }
  ],
  "testPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 30 }
    }
  ],
  "buildPresets": [
    {
      "name": "win32-release",
      "configurePreset": "win32",
      "configuration": "Release",
      "targets": [
        "baseline_sdk_probe", "NppLdapFormatter", "plugin_abi_smoke", "ldap_parser_tests", "scintilla_gateway_tests", "plugin_controller_tests", "plugin_dll_e2e_tests"
      ]
    },
    {
      "name": "x64-release",
      "configurePreset": "x64",
      "configuration": "Release",
      "targets": [
        "baseline_sdk_probe", "NppLdapFormatter", "plugin_abi_smoke", "ldap_parser_tests", "scintilla_gateway_tests", "plugin_controller_tests", "plugin_dll_e2e_tests"
      ]
    },
    {
      "name": "arm64-release",
      "configurePreset": "arm64",
      "configuration": "Release",
      "targets": [
        "baseline_sdk_probe", "NppLdapFormatter", "plugin_abi_smoke", "ldap_parser_tests", "scintilla_gateway_tests", "plugin_controller_tests", "plugin_dll_e2e_tests"
      ]
    }
  ]
}
